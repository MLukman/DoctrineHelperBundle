{
	"name": "mlukman/doctrine-helper-bundle",
	"version": "1.2.11",
	"description": "A set of classes to simplify Symfony-Doctrine integration",
	"type": "symfony-bundle",
	"require": {
		"php": ">=8.2",
		"doctrine/doctrine-bundle": "^2.8|^3.0",
		"doctrine/orm": "^2.8|^3.0",
		"imagine/imagine": "^1.3",
		"phpdocumentor/reflection-docblock": "^5.3",
		"ramsey/uuid-doctrine": "^2.0",
		"symfony/framework-bundle": "^7.4|^8.0",
		"symfony/property-access": "^7.4|^8.0",
		"symfony/property-info": "^7.4|^8.0",
		"symfony/runtime": "^7.4|^8.0",
		"symfony/serializer": "^7.4|^8.0",
		"symfony/validator": "^7.4|^8.0",
		"symfony/var-exporter": "^7.4|^8.0"
	},
	"suggest": {
		"mlukman/security-helper-bundle": "1.*"
	},
	"config": {
		"allow-plugins": {
			"symfony/flex": true,
			"symfony/runtime": true
		},
		"sort-packages": true
	},
	"autoload": {
		"psr-4": {
			"MLukman\\DoctrineHelperBundle\\": "src/"
		}
	},
	"license": "MIT",
	"authors": [
		{
			"name": "Muhammad Lukman Nasaruddin",
			"email": "lukman.nasaruddin@gmail.com"
		}
	],
	"autoload-dev": {
		"psr-4": {
			"MLukman\\DoctrineHelperBundle\\Tests\\": "tests/"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^9.5",
		"symfony/debug-bundle": "^7.0",
		"symfony/phpunit-bridge": "^7.0",
		"symfony/yaml": "^7.0"
	}
}
